NEXT_PUBLIC_APP_NAME=ResQRoute

# Optional MapLibre style URL. The no-key default is an inline OSM raster style.
# OpenFreeMap is a no-key vector-style option for demonstrations.
# Use a MapTiler or self-hosted style URL for production scale.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# NEXT_PUBLIC_MAP_ATTRIBUTION=Map data © OpenStreetMap contributors · tiles OpenFreeMap

# Server-side location providers.
# MapTiler geocoding is preferred when a key is configured.
MAPTILER_API_KEY=
# Leave empty for the throttled local Nominatim fallback, or set to maptiler when a key is available.
GEOCODING_PROVIDER=
ROUTING_PROVIDER_URL=https://router.project-osrm.org

# Required when the development fallback uses Nominatim.
APP_CONTACT_URL=http://localhost:3000
